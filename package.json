{
  "name": "soundpad-improved",
  "version": "0.1.0",
  "description": "Soundboard polyphonique : plusieurs sons à la fois, volume réglable en direct, import de la bibliothèque Soundpad.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "build:native": "native\\build.cmd",
    "test:native": "native\\bin\\test_apo.exe native\\bin",
    "dist": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.augaton.soundpad-improved",
    "productName": "Soundpad Improved",
    "asar": false,
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "hotkeys.ps1",
      "src/**",
      "native/mic-filter.ps1",
      "native/bin/SoundpadImprovedApo.dll",
      "native/bin/spi-feed.exe"
    ],
    "portable": {
      "artifactName": "Soundpad-Improved-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "~44.9.3",
    "electron-builder": "^26.15.3"
  }
}
